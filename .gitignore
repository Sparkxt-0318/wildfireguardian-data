# Raw fetched source data is never committed: licences differ per source and a
# multi-megabyte tile in git history is unreviewable and unremovable.
# Provenance + checksum + a re-fetch command is the reproducibility mechanism.
# See docs/DECISIONS.md D-0012.
data/raw/
data/interim/

# Built bundles, except the committed example (see data/study_areas/.gitignore)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Credentials. Several Korean sources need an API key per dataset, so a
# developer here will eventually have one on disk. A key committed once is
# committed forever, so the ignore is in place before the file exists rather
# than after (Phase 2 item 5). Keys are read from the environment; this
# repository writes no credential to any tracked file and prints none.
.env
.env.*
!.env.example
*.pem
*.key
.netrc

# Locally built bundles other than the two committed examples
# (docs/DATA_PROVENANCE.md lists which are committed and why).
data/study_areas/*
!data/study_areas/uljin_valley_synthetic_v1/
!data/study_areas/uljin_valley_synthetic_v1/**
!data/study_areas/uljin_real_v1/
!data/study_areas/uljin_real_v1/**
